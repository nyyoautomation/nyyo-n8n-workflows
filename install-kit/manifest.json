{
  "name": "Nyyo Automation n8n templates",
  "version": "1.1.0",
  "tested_on": "n8n 2.43.8 self-hosted",
  "license": "MIT",
  "workflows": [
    {
      "file": "01_lead_to_sheets_slack_ai.json",
      "path": "workflows/01_lead_to_sheets_slack_ai.json",
      "title": "Send website form leads to Google Sheets and Slack with an AI-drafted reply"
    },
    {
      "file": "02_invoice_email_pdf_to_sheets.json",
      "path": "workflows/02_invoice_email_pdf_to_sheets.json",
      "title": "Extract invoice data from email PDF attachments into Google Sheets"
    },
    {
      "file": "03_support_inbox_triage_slack.json",
      "path": "workflows/03_support_inbox_triage_slack.json",
      "title": "Triage support emails from IMAP, alert Slack on urgent ones and auto-acknowledge the rest"
    }
  ],
  "one_command_setup": {
    "mac_linux": "./setup.sh",
    "windows": "powershell -ExecutionPolicy Bypass -File .\\setup.ps1",
    "options": [
      "--postgres / -Postgres",
      "--port N / -Port N"
    ],
    "compose": "docker-compose.yml",
    "env_template": ".env.example",
    "guide": "INSTALL.md",
    "n8n_image": "docker.n8n.io/n8nio/n8n:2.43.8",
    "database": "SQLite (default) or Postgres 16 (optional profile)"
  }
}
