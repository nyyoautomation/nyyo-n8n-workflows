{
  "name": "Nyyo \u2014 Competitor price watch",
  "nodes": [
    {
      "id": "1",
      "name": "Every morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "2",
      "name": "Fetch public page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "parameters": {}
    },
    {
      "id": "3",
      "name": "Parse prices",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "parameters": {}
    },
    {
      "id": "4",
      "name": "Price dropped?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        660,
        0
      ],
      "parameters": {}
    },
    {
      "id": "5",
      "name": "Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        880,
        0
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Every morning": {
      "main": [
        [
          {
            "node": "Fetch public page",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch public page": {
      "main": [
        [
          {
            "node": "Parse prices",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse prices": {
      "main": [
        [
          {
            "node": "Price dropped?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Price dropped?": {
      "main": [
        [
          {
            "node": "Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true,
    "nyyo": "demo"
  },
  "tags": [
    {
      "name": "Nyyo Automation demo"
    }
  ]
}