    {
      "parameters": {
        "jsCode": "// Clean and validate every incoming form submission.\n// Accepts JSON or form-encoded bodies and a few common field aliases.\nconst clean = (v) => (v === undefined || v === null ? '' : String(v)).trim().replace(/\\s+/g, ' ');\n\nreturn $('Receive form lead').all().map((item) => {\n  const raw = item.json.body ?? item.json;\n  const fullName = clean(raw.name || raw.full_name || `${raw.first_name ?? ''} ${raw.last_name ?? ''}`);\n  const lead = {\n    received_at: new Date().toISOString(),\n    name: fullName,\n    email: clean(raw.email).toLowerCase(),\n    company: clean(raw.company || raw.organization),\n    message: String(raw.message ?? raw.comments ?? '').trim().slice(0, 4000),\n    source: clean(raw.source || raw.utm_source) || 'website',\n  };\n\n  const errors = [];\n  if (!lead.name) errors.push('name is required');\n  if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(lead.email)) errors.push('a valid email is required');\n  if (!lead.message) errors.push('message is required');\n  // Honeypot: keep a hidden \"website_hp\" field in your form. Humans leave it empty, bots fill it.\n  if (clean(raw.website_hp)) errors.push('rejected as spam');\n\n  return { json: { ...lead, is_valid: errors.length === 0, errors } };\n});"
      },
