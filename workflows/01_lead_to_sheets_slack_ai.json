    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a short first reply (maximum 120 words) to this inbound lead on behalf of {{ $('Config').first().json.companyName }}.\nTone: {{ $('Config').first().json.replyTone }}.\nRules: answer in the language of the message, do not promise prices, dates or anything that is not in the message, end with one question that moves the conversation forward, sign as {{ $('Config').first().json.senderName }}.\n\nName: {{ $json.name }}\nCompany: {{ $json.company }}\nMessage: {{ $json.message }}",
        "batching": {}
      },
