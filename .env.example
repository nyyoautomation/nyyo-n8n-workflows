# Settings for docker-compose.yml. PLACEHOLDERS ONLY.
# setup.sh / setup.ps1 copies this file to .env and fills in the REPLACE_WITH_ values with random ones.
# Never share or commit your .env: it holds the key that encrypts the credentials you add in n8n.

# n8n version (the templates were tested on 2.43.8).
N8N_VERSION=2.43.8

# Port on this computer: n8n opens at http://localhost:5678
N8N_PORT=5678

# Time zone used by n8n, for example America/New_York, Asia/Singapore or UTC.
TIMEZONE=UTC

# Public address of n8n, used to build webhook URLs. Keep the default for a local install.
WEBHOOK_URL=http://localhost:5678/

# Encrypts the credentials you create in n8n. Keep it safe: if you lose it, saved credentials can't be read.
N8N_ENCRYPTION_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING

# --- Optional Postgres (choose at first setup: ./setup.sh --postgres) ---
# Leave empty for SQLite. Set to "postgres" together with DB_TYPE=postgresdb to use Postgres.
COMPOSE_PROFILES=
DB_TYPE=sqlite
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
